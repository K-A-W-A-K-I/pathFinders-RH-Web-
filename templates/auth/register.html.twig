<!DOCTYPE html>
<html lang="fr" data-theme="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Inscription — PathFinder RH</title>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;font-family:'DM Sans',sans-serif}

body{
  min-height:100vh;
  background:#070712;
  display:flex;
  align-items:stretch;
  overflow-x:hidden;
}

/* ── Left branding ── */
.auth-left{
  flex:1;
  display:flex;flex-direction:column;justify-content:center;align-items:center;
  padding:60px 48px;position:relative;overflow:hidden;
  background:linear-gradient(145deg,#0d0b22 0%,#130f2e 50%,#0a0918 100%);
}
.auth-left::before{
  content:'';position:absolute;inset:0;
  background:radial-gradient(ellipse 80% 60% at 30% 40%,rgba(108,99,255,.22),transparent 70%),
             radial-gradient(ellipse 60% 50% at 80% 80%,rgba(157,107,255,.14),transparent 70%);
  pointer-events:none;
}
.left-grid{
  position:absolute;inset:0;
  background-image:linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),
                   linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px);
  background-size:52px 52px;
  mask-image:radial-gradient(ellipse 90% 90% at 50% 50%,black 20%,transparent 100%);
  pointer-events:none;
}
.left-content{position:relative;z-index:1;max-width:400px;width:100%}
.left-logo{display:flex;align-items:center;gap:12px;margin-bottom:56px}
.left-logo-icon{
  width:42px;height:42px;border-radius:12px;
  background:linear-gradient(135deg,#6C63FF,#9D6BFF);
  display:flex;align-items:center;justify-content:center;
  font-family:'Sora',sans-serif;font-weight:800;font-size:16px;color:#fff;
  box-shadow:0 6px 20px rgba(108,99,255,.45);
}
.left-logo-text{font-family:'Sora',sans-serif;font-weight:700;font-size:17px;color:#fff;letter-spacing:-.02em}

.left-headline{
  font-family:'Sora',sans-serif;font-size:2.4rem;font-weight:800;
  color:#fff;line-height:1.15;letter-spacing:-.04em;margin-bottom:18px;
}
.left-headline span{
  background:linear-gradient(135deg,#6C63FF,#c084fc);
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
}
.left-sub{font-size:14.5px;color:rgba(232,230,240,.5);line-height:1.7;font-weight:300;margin-bottom:40px}

.steps{display:flex;flex-direction:column;gap:0}
.step{display:flex;gap:16px;position:relative}
.step:not(:last-child)::after{
  content:'';position:absolute;left:15px;top:36px;
  width:1px;height:calc(100% - 8px);
  background:linear-gradient(to bottom,rgba(108,99,255,.4),rgba(108,99,255,.05));
}
.step-num{
  width:32px;height:32px;border-radius:50%;flex-shrink:0;
  background:linear-gradient(135deg,#6C63FF,#9D6BFF);
  display:flex;align-items:center;justify-content:center;
  font-size:12px;font-weight:700;color:#fff;
  box-shadow:0 4px 12px rgba(108,99,255,.35);
}
.step-body{padding-bottom:24px}
.step-title{font-size:14px;font-weight:600;color:rgba(232,230,240,.9);margin-bottom:3px}
.step-desc{font-size:12.5px;color:rgba(232,230,240,.45);line-height:1.5}

/* ── Right form ── */
.auth-right{
  width:520px;flex-shrink:0;
  display:flex;flex-direction:column;justify-content:center;
  padding:48px 48px;
  background:#09091a;
  border-left:.5px solid rgba(255,255,255,.06);
  position:relative;overflow-y:auto;
}
.auth-right::before{
  content:'';position:absolute;
  width:400px;height:400px;border-radius:50%;
  background:radial-gradient(circle,rgba(108,99,255,.07),transparent 70%);
  top:-100px;right:-100px;pointer-events:none;
}

.form-header{margin-bottom:28px}
.form-eyebrow{
  display:inline-flex;align-items:center;gap:6px;
  padding:4px 12px;border-radius:100px;
  background:rgba(108,99,255,.12);border:.5px solid rgba(108,99,255,.25);
  font-size:11.5px;font-weight:600;color:#a89bff;letter-spacing:.04em;
  text-transform:uppercase;margin-bottom:14px;
}
.form-eyebrow-dot{width:5px;height:5px;border-radius:50%;background:#6C63FF}
.form-title{font-family:'Sora',sans-serif;font-size:1.65rem;font-weight:700;color:#fff;letter-spacing:-.03em;margin-bottom:5px}
.form-sub{font-size:13.5px;color:rgba(232,230,240,.4);font-weight:300}

/* Grid */
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.form-group{margin-bottom:14px}
.form-label{
  display:block;font-size:11.5px;font-weight:600;
  color:rgba(232,230,240,.5);letter-spacing:.05em;
  text-transform:uppercase;margin-bottom:7px;
}
.input-wrap{position:relative}
.input-icon{
  position:absolute;left:13px;top:50%;transform:translateY(-50%);
  font-size:14px;opacity:.35;pointer-events:none;
}
input{
  width:100%;padding:12px 14px 12px 40px;
  background:rgba(255,255,255,.05);
  border:.5px solid rgba(255,255,255,.1);
  border-radius:11px;
  color:#e8e6f0;font-size:13.5px;font-family:'DM Sans',sans-serif;
  outline:none;transition:border-color .2s,background .2s,box-shadow .2s;
}
input::placeholder{color:rgba(232,230,240,.22)}
input:focus{
  border-color:rgba(108,99,255,.55);
  background:rgba(108,99,255,.07);
  box-shadow:0 0 0 3px rgba(108,99,255,.1);
}
input.is-invalid{border-color:rgba(239,68,68,.5)}
.field-error{color:#f87171;font-size:11.5px;margin-top:5px;display:flex;align-items:center;gap:4px}

/* Password strength */
.pw-strength{margin-top:6px;display:flex;gap:4px}
.pw-bar{flex:1;height:3px;border-radius:2px;background:rgba(255,255,255,.08);transition:background .3s}
.pw-bar.weak{background:#ef4444}
.pw-bar.medium{background:#f59e0b}
.pw-bar.strong{background:#22c55e}

/* Submit */
.btn-submit{
  width:100%;padding:14px;margin-top:6px;
  background:linear-gradient(135deg,#6C63FF,#9D6BFF);
  border:none;border-radius:12px;
  color:#fff;font-size:15px;font-weight:600;font-family:'DM Sans',sans-serif;
  cursor:pointer;transition:opacity .2s,transform .15s,box-shadow .2s;
  box-shadow:0 6px 24px rgba(108,99,255,.4);
  display:flex;align-items:center;justify-content:center;gap:8px;
}
.btn-submit:hover{opacity:.92;transform:translateY(-1px);box-shadow:0 10px 32px rgba(108,99,255,.5)}

/* Alert */
.alert-error{
  display:flex;align-items:flex-start;gap:10px;
  background:rgba(239,68,68,.08);border:.5px solid rgba(239,68,68,.25);
  color:#f87171;border-radius:12px;padding:12px 14px;font-size:13px;margin-bottom:16px;
}

/* Footer */
.form-footer{text-align:center;margin-top:22px;font-size:13.5px;color:rgba(232,230,240,.4)}
.form-footer a{color:#9D6BFF;text-decoration:none;font-weight:600}
.form-footer a:hover{color:#c084fc}

/* reCAPTCHA */
.recaptcha-wrap{display:flex;justify-content:center;margin:12px 0 6px}

/* Back link */
.back-link{
  position:fixed;top:20px;left:20px;z-index:100;
  display:flex;align-items:center;gap:7px;
  padding:7px 14px;border-radius:100px;
  background:rgba(255,255,255,.05);border:.5px solid rgba(255,255,255,.1);
  color:rgba(232,230,240,.5);font-size:12.5px;text-decoration:none;
  transition:all .2s;backdrop-filter:blur(10px);
}
.back-link:hover{background:rgba(255,255,255,.1);color:#e8e6f0}
.back-link img{height:18px;opacity:.7}

@media(max-width:960px){
  .auth-left{display:none}
  .auth-right{width:100%;border-left:none;padding:40px 24px}
}
</style>
</head>
<body>

<a href="{{ path('offre_list') }}" class="back-link">
  <img src="{{ asset('logowhite.png') }}" alt="PathFinder">
  Retour
</a>

<!-- Left branding -->
<div class="auth-left">
  <div class="left-grid"></div>
  <div class="left-content">
    <div class="left-logo">
      <div class="left-logo-icon">PF</div>
      <span class="left-logo-text">PathFinder RH</span>
    </div>

    <h1 class="left-headline">
      Rejoignez<br><span>PathFinder</span><br>aujourd'hui
    </h1>
    <p class="left-sub">
      Créez votre profil en quelques minutes et accédez à des centaines d'opportunités.
    </p>

    <div class="steps">
      <div class="step">
        <div class="step-num">1</div>
        <div class="step-body">
          <div class="step-title">Créez votre compte</div>
          <div class="step-desc">Remplissez vos informations de base</div>
        </div>
      </div>
      <div class="step">
        <div class="step-num">2</div>
        <div class="step-body">
          <div class="step-title">Complétez votre profil</div>
          <div class="step-desc">Ajoutez votre CV et lettre de motivation</div>
        </div>
      </div>
      <div class="step">
        <div class="step-num">3</div>
        <div class="step-body">
          <div class="step-title">Postulez aux offres</div>
          <div class="step-desc">Candidatez en un clic aux offres qui vous correspondent</div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Right form -->
<div class="auth-right">
  <div class="form-header">
    <div class="form-eyebrow">
      <div class="form-eyebrow-dot"></div>
      Inscription gratuite
    </div>
    <h1 class="form-title">Créer un compte ✨</h1>
    <p class="form-sub">Rejoignez des milliers de candidats sur PathFinder</p>
  </div>

  {% for message in app.flashes('error') %}
    <div class="alert-error">⚠️ {{ message }}</div>
  {% endfor %}

  {{ form_start(form, {attr: {novalidate: 'novalidate', id: 'register-form'}}) }}

  <div class="form-row">
    <div class="form-group">
      <label class="form-label">Nom *</label>
      <div class="input-wrap">
        <span class="input-icon">👤</span>
        {{ form_widget(form.nom, {attr: {placeholder: 'Votre nom', class: form.nom.vars.errors|length ? 'is-invalid' : ''}}) }}
      </div>
      {% for e in form.nom.vars.errors %}<div class="field-error">⚠ {{ e.message }}</div>{% endfor %}
    </div>
    <div class="form-group">
      <label class="form-label">Prénom *</label>
      <div class="input-wrap">
        <span class="input-icon">👤</span>
        {{ form_widget(form.prenom, {attr: {placeholder: 'Votre prénom', class: form.prenom.vars.errors|length ? 'is-invalid' : ''}}) }}
      </div>
      {% for e in form.prenom.vars.errors %}<div class="field-error">⚠ {{ e.message }}</div>{% endfor %}
    </div>
  </div>

  <div class="form-group">
    <label class="form-label">Adresse email *</label>
    <div class="input-wrap">
      <span class="input-icon">✉️</span>
      {{ form_widget(form.email, {attr: {placeholder: 'exemple@email.com', class: form.email.vars.errors|length ? 'is-invalid' : ''}}) }}
    </div>
    {% for e in form.email.vars.errors %}<div class="field-error">⚠ {{ e.message }}</div>{% endfor %}
  </div>

  <div class="form-row">
    <div class="form-group">
      <label class="form-label">Mot de passe *</label>
      <div class="input-wrap">
        <span class="input-icon">🔒</span>
        {{ form_widget(form.plainPassword.first, {attr: {placeholder: 'Min. 6 caractères', id: 'pw-input', class: form.plainPassword.vars.errors|length ? 'is-invalid' : ''}}) }}
      </div>
      <div class="pw-strength">
        <div class="pw-bar" id="pw-bar-1"></div>
        <div class="pw-bar" id="pw-bar-2"></div>
        <div class="pw-bar" id="pw-bar-3"></div>
      </div>
    </div>
    <div class="form-group">
      <label class="form-label">Confirmer *</label>
      <div class="input-wrap">
        <span class="input-icon">🔒</span>
        {{ form_widget(form.plainPassword.second, {attr: {placeholder: 'Répétez', class: form.plainPassword.vars.errors|length ? 'is-invalid' : ''}}) }}
      </div>
    </div>
  </div>
  {% for e in form.plainPassword.vars.errors %}
    <div class="field-error" style="margin-top:-8px;margin-bottom:10px">⚠ {{ e.message }}</div>
  {% endfor %}

  {% if recaptcha_site_key is not empty %}
    <div class="recaptcha-wrap">
      <div class="g-recaptcha" data-sitekey="{{ recaptcha_site_key }}"></div>
    </div>
  {% endif %}

  <button type="submit" class="btn-submit">
    <span>Créer mon compte</span>
    <span>→</span>
  </button>

  {{ form_end(form) }}

  <div class="form-footer">
    Déjà un compte ? <a href="{{ path('auth_login') }}">Se connecter</a>
  </div>
</div>

{% if recaptcha_site_key is not empty %}
<script src="https://www.google.com/recaptcha/api.js" async defer></script>
{% endif %}

<script>
const pwInput = document.getElementById('pw-input');
const bars = [document.getElementById('pw-bar-1'), document.getElementById('pw-bar-2'), document.getElementById('pw-bar-3')];

if (pwInput) {
  pwInput.addEventListener('input', function() {
    const v = this.value;
    let strength = 0;
    if (v.length >= 6) strength++;
    if (v.length >= 10 && /[A-Z]/.test(v)) strength++;
    if (/[0-9]/.test(v) && /[^A-Za-z0-9]/.test(v)) strength++;

    bars.forEach((b, i) => {
      b.className = 'pw-bar';
      if (i < strength) {
        b.classList.add(strength === 1 ? 'weak' : strength === 2 ? 'medium' : 'strong');
      }
    });
  });
}
</script>
</body>
</html>
