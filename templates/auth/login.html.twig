<!DOCTYPE html>
<html lang="fr" data-theme="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Connexion — PathFinder RH</title>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;font-family:'DM Sans',sans-serif}

body{
  min-height:100vh;
  background:#070712;
  display:flex;
  align-items:stretch;
  overflow:hidden;
}

/* ── Left panel ── */
.auth-left{
  flex:1;
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;
  padding:60px 48px;
  position:relative;
  overflow:hidden;
  background:linear-gradient(145deg,#0d0b22 0%,#130f2e 50%,#0a0918 100%);
}
.auth-left::before{
  content:'';position:absolute;inset:0;
  background:radial-gradient(ellipse 80% 60% at 30% 40%,rgba(108,99,255,.22),transparent 70%),
             radial-gradient(ellipse 60% 50% at 80% 80%,rgba(157,107,255,.14),transparent 70%);
  pointer-events:none;
}
.left-grid{
  position:absolute;inset:0;
  background-image:linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),
                   linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px);
  background-size:52px 52px;
  mask-image:radial-gradient(ellipse 90% 90% at 50% 50%,black 20%,transparent 100%);
  pointer-events:none;
}
.left-content{position:relative;z-index:1;max-width:420px;width:100%}
.left-logo{display:flex;align-items:center;gap:12px;margin-bottom:64px}
.left-logo-icon{
  width:42px;height:42px;border-radius:12px;
  background:linear-gradient(135deg,#6C63FF,#9D6BFF);
  display:flex;align-items:center;justify-content:center;
  font-family:'Sora',sans-serif;font-weight:800;font-size:16px;color:#fff;
  box-shadow:0 6px 20px rgba(108,99,255,.45);
}
.left-logo-text{font-family:'Sora',sans-serif;font-weight:700;font-size:17px;color:#fff;letter-spacing:-.02em}

.left-headline{
  font-family:'Sora',sans-serif;font-size:2.6rem;font-weight:800;
  color:#fff;line-height:1.15;letter-spacing:-.04em;margin-bottom:20px;
}
.left-headline span{
  background:linear-gradient(135deg,#6C63FF,#c084fc);
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
}
.left-sub{font-size:15px;color:rgba(232,230,240,.5);line-height:1.7;font-weight:300;margin-bottom:48px}

.left-features{display:flex;flex-direction:column;gap:16px}
.feature-item{display:flex;align-items:center;gap:14px}
.feature-icon{
  width:38px;height:38px;border-radius:10px;flex-shrink:0;
  background:rgba(108,99,255,.15);border:.5px solid rgba(108,99,255,.3);
  display:flex;align-items:center;justify-content:center;font-size:16px;
}
.feature-text{font-size:13.5px;color:rgba(232,230,240,.6);font-weight:400}
.feature-text strong{color:rgba(232,230,240,.9);font-weight:600}

.left-dots{
  position:absolute;bottom:40px;left:48px;display:flex;gap:8px;z-index:1;
}
.dot{width:6px;height:6px;border-radius:50%;background:rgba(255,255,255,.15)}
.dot.active{background:#6C63FF;width:22px;border-radius:3px}

/* ── Right panel (form) ── */
.auth-right{
  width:480px;flex-shrink:0;
  display:flex;flex-direction:column;justify-content:center;
  padding:60px 48px;
  background:#09091a;
  border-left:.5px solid rgba(255,255,255,.06);
  position:relative;overflow:hidden;
}
.auth-right::before{
  content:'';position:absolute;
  width:400px;height:400px;border-radius:50%;
  background:radial-gradient(circle,rgba(108,99,255,.08),transparent 70%);
  top:-100px;right:-100px;pointer-events:none;
}

.form-header{margin-bottom:36px}
.form-eyebrow{
  display:inline-flex;align-items:center;gap:6px;
  padding:4px 12px;border-radius:100px;
  background:rgba(108,99,255,.12);border:.5px solid rgba(108,99,255,.25);
  font-size:11.5px;font-weight:600;color:#a89bff;letter-spacing:.04em;
  text-transform:uppercase;margin-bottom:16px;
}
.form-eyebrow-dot{width:5px;height:5px;border-radius:50%;background:#6C63FF}
.form-title{font-family:'Sora',sans-serif;font-size:1.75rem;font-weight:700;color:#fff;letter-spacing:-.03em;margin-bottom:6px}
.form-sub{font-size:14px;color:rgba(232,230,240,.45);font-weight:300}

/* Inputs */
.form-group{margin-bottom:18px;position:relative}
.form-label{
  display:flex;align-items:center;justify-content:space-between;
  font-size:12px;font-weight:600;color:rgba(232,230,240,.55);
  letter-spacing:.05em;text-transform:uppercase;margin-bottom:8px;
}
.form-label a{color:#9D6BFF;font-size:12px;text-transform:none;letter-spacing:0;font-weight:500;text-decoration:none}
.form-label a:hover{text-decoration:underline}

.input-wrap{position:relative}
.input-icon{
  position:absolute;left:14px;top:50%;transform:translateY(-50%);
  font-size:15px;opacity:.4;pointer-events:none;
}
input{
  width:100%;padding:13px 16px 13px 42px;
  background:rgba(255,255,255,.05);
  border:.5px solid rgba(255,255,255,.1);
  border-radius:12px;
  color:#e8e6f0;font-size:14px;font-family:'DM Sans',sans-serif;
  outline:none;transition:border-color .2s,background .2s,box-shadow .2s;
}
input::placeholder{color:rgba(232,230,240,.25)}
input:focus{
  border-color:rgba(108,99,255,.55);
  background:rgba(108,99,255,.07);
  box-shadow:0 0 0 3px rgba(108,99,255,.1);
}

/* Button */
.btn-submit{
  width:100%;padding:14px;margin-top:4px;
  background:linear-gradient(135deg,#6C63FF,#9D6BFF);
  border:none;border-radius:12px;
  color:#fff;font-size:15px;font-weight:600;font-family:'DM Sans',sans-serif;
  cursor:pointer;transition:opacity .2s,transform .15s,box-shadow .2s;
  box-shadow:0 6px 24px rgba(108,99,255,.4);
  display:flex;align-items:center;justify-content:center;gap:8px;
}
.btn-submit:hover{opacity:.92;transform:translateY(-1px);box-shadow:0 10px 32px rgba(108,99,255,.5)}
.btn-submit:active{transform:translateY(0)}

/* Divider */
.divider{display:flex;align-items:center;gap:12px;margin:22px 0}
.divider-line{flex:1;height:.5px;background:rgba(255,255,255,.08)}
.divider-text{font-size:12px;color:rgba(232,230,240,.3)}

/* Alert */
.alert-error{
  display:flex;align-items:flex-start;gap:10px;
  background:rgba(239,68,68,.08);border:.5px solid rgba(239,68,68,.25);
  color:#f87171;border-radius:12px;padding:12px 14px;font-size:13px;margin-bottom:20px;
}
.alert-error-icon{font-size:15px;flex-shrink:0;margin-top:1px}

/* Footer */
.form-footer{text-align:center;margin-top:28px;font-size:13.5px;color:rgba(232,230,240,.4)}
.form-footer a{color:#9D6BFF;text-decoration:none;font-weight:600}
.form-footer a:hover{color:#c084fc}

/* Responsive */
@media(max-width:900px){
  .auth-left{display:none}
  .auth-right{width:100%;border-left:none;padding:40px 24px}
}

/* Floating back link */
.back-link{
  position:fixed;top:20px;left:20px;z-index:100;
  display:flex;align-items:center;gap:7px;
  padding:7px 14px;border-radius:100px;
  background:rgba(255,255,255,.05);border:.5px solid rgba(255,255,255,.1);
  color:rgba(232,230,240,.5);font-size:12.5px;text-decoration:none;
  transition:all .2s;backdrop-filter:blur(10px);
}
.back-link:hover{background:rgba(255,255,255,.1);color:#e8e6f0}
.back-link img{height:18px;opacity:.7}
</style>
</head>
<body>

<a href="{{ path('offre_list') }}" class="back-link">
  <img src="{{ asset('logowhite.png') }}" alt="PathFinder">
  Retour
</a>

<!-- Left branding panel -->
<div class="auth-left">
  <div class="left-grid"></div>
  <div class="left-content">
    <div class="left-logo">
      <div class="left-logo-icon">PF</div>
      <span class="left-logo-text">PathFinder RH</span>
    </div>

    <h1 class="left-headline">
      Votre carrière<br>commence <span>ici</span>
    </h1>
    <p class="left-sub">
      Accédez à des centaines d'offres d'emploi, gérez vos candidatures et développez vos compétences.
    </p>

    <div class="left-features">
      <div class="feature-item">
        <div class="feature-icon">🎯</div>
        <div class="feature-text"><strong>Offres ciblées</strong> selon votre profil</div>
      </div>
      <div class="feature-item">
        <div class="feature-icon">📊</div>
        <div class="feature-text"><strong>Suivi en temps réel</strong> de vos candidatures</div>
      </div>
      <div class="feature-item">
        <div class="feature-icon">🎓</div>
        <div class="feature-text"><strong>Formations</strong> pour booster vos compétences</div>
      </div>
      <div class="feature-item">
        <div class="feature-icon">🔔</div>
        <div class="feature-text"><strong>Alertes</strong> pour les nouvelles opportunités</div>
      </div>
    </div>
  </div>
  <div class="left-dots">
    <div class="dot active"></div>
    <div class="dot"></div>
    <div class="dot"></div>
  </div>
</div>

<!-- Right form panel -->
<div class="auth-right">
  <div class="form-header">
    <div class="form-eyebrow">
      <div class="form-eyebrow-dot"></div>
      Espace sécurisé
    </div>
    <h1 class="form-title">Bon retour 👋</h1>
    <p class="form-sub">Connectez-vous à votre espace PathFinder</p>
  </div>

  {% if error %}
    <div class="alert-error">
      <span class="alert-error-icon">⚠️</span>
      {{ error.messageKey|trans(error.messageData, 'security') }}
    </div>
  {% endif %}

  <form method="post" action="{{ path('auth_login_check') }}" novalidate>
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

    <div class="form-group">
      <div class="form-label">
        <span>Adresse email</span>
      </div>
      <div class="input-wrap">
        <span class="input-icon">✉️</span>
        <input type="email" name="_username" value="{{ last_username }}"
               placeholder="exemple@email.com" autocomplete="email" autofocus>
      </div>
    </div>

    <div class="form-group">
      <div class="form-label">
        <span>Mot de passe</span>
        <a href="{{ path('auth_forgot_password') }}">Oublié ?</a>
      </div>
      <div class="input-wrap">
        <span class="input-icon">🔒</span>
        <input type="password" name="_password"
               placeholder="Votre mot de passe" autocomplete="current-password">
      </div>
    </div>

    <button type="submit" class="btn-submit">
      <span>Se connecter</span>
      <span>→</span>
    </button>
  </form>

  <div class="form-footer">
    Pas encore de compte ?
    <a href="{{ path('auth_register') }}">Créer un compte</a>
  </div>
</div>

</body>
</html>
