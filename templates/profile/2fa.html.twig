{% extends 'client/base_client.html.twig' %}
{% block title %}Sécurité 2FA{% endblock %}

{% block body %}
<div class="pf-hero">
  <div class="pf-hero-bg"></div>
  <div class="pf-hero-grid"></div>
  <div class="pf-hero-inner">
    <div class="pf-hero-badge"><div class="pf-hero-badge-dot"></div>Sécurité du compte</div>
    <h1>Authentification <span>2FA</span></h1>
    <p>Scannez ce QR code avec Microsoft Authenticator puis confirmez avec un code.</p>
  </div>
</div>

<div class="pf-content">
  <div class="pf-section" style="max-width:760px">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.2rem;align-items:start">
      <div style="padding:1rem;border:.5px solid var(--border);border-radius:12px;background:var(--surface)">
        <div style="font-size:12px;color:var(--text-muted);margin-bottom:.6rem">QR code</div>
        <img
          alt="QR code 2FA"
          src="https://api.qrserver.com/v1/create-qr-code/?size=240x240&data={{ qr_content|url_encode }}"
          style="width:100%;max-width:240px;border-radius:10px;border:.5px solid var(--border)"
        >
      </div>

      <div style="padding:1rem;border:.5px solid var(--border);border-radius:12px;background:var(--surface)">
        <div style="font-size:12px;color:var(--text-muted);margin-bottom:.6rem">Statut</div>
        <div style="font-weight:700;color:var(--text);margin-bottom:1rem">
          {{ enabled ? 'Activée' : 'Désactivée' }}
        </div>

        {% if not enabled %}
          <form method="post" action="{{ path('profile_2fa_enable') }}" style="display:grid;gap:.8rem">
            <label style="font-size:12px;color:var(--text-muted)">Code à 6 chiffres</label>
            <input
              type="text"
              name="code"
              maxlength="6"
              pattern="[0-9]{6}"
              required
              style="width:100%;padding:10px 14px;border:.5px solid var(--border);border-radius:9px;font-size:14px;font-family:DM Sans,sans-serif;background:var(--surface);color:var(--text);outline:none;"
            >
            <button type="submit" class="pf-btn-details">Activer la 2FA</button>
          </form>
        {% else %}
          <form method="post" action="{{ path('profile_2fa_disable') }}" onsubmit="return confirm('Désactiver la 2FA ?')">
            <button type="submit" class="pf-btn-ghost" style="padding:8px 18px;border-radius:10px">Désactiver la 2FA</button>
          </form>
        {% endif %}

        <div style="margin-top:1rem">
          <a href="{{ path('profile_index') }}" class="pf-btn-ghost" style="padding:8px 18px;border-radius:10px;text-decoration:none">Retour profil</a>
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}
