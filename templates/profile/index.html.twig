{% extends 'client/base_client.html.twig' %}
{% block title %}Mon Profil{% endblock %}
{% block nav_candidatures %}{% endblock %}

{% block body %}
<div class="pf-hero">
  <div class="pf-hero-bg"></div>
  <div class="pf-hero-grid"></div>
  <div class="pf-hero-inner">
    <div class="pf-hero-badge"><div class="pf-hero-badge-dot"></div>Espace candidat</div>
    <h1>Mon <span>Profil</span></h1>
    <p>Gérez vos informations personnelles, votre CV et vos documents.</p>
  </div>
</div>

<div class="pf-content">
<div class="profile-layout">

  <!-- Sidebar -->
  <aside class="profile-sidebar">
    <div class="profile-avatar-card">
      {% if user.imageUrl %}
        <img src="{{ user.imageUrl starts with 'http' ? user.imageUrl : asset(user.imageUrl) }}"
             alt="{{ user.fullName }}" class="profile-avatar-img">
      {% else %}
        <div class="profile-avatar-initials">{{ user.fullName|slice(0,1)|upper }}</div>
      {% endif %}

      <div class="profile-avatar-glow"></div>

      <div class="profile-name">{{ user.fullName }}</div>
      <div class="profile-email">{{ user.email }}</div>

      <div class="profile-role-badge">
        {% if 'ROLE_ADMIN' in user.roles %}
          <span class="role-dot role-admin"></span> Administrateur
        {% elseif 'ROLE_WORKER' in user.roles %}
          <span class="role-dot role-worker"></span> Employé
        {% else %}
          <span class="role-dot role-candidat"></span> Candidat
        {% endif %}
      </div>

      <div class="profile-stats">
        <div class="profile-stat">
          <div class="profile-stat-value">{{ user.statut ?? 'actif' }}</div>
          <div class="profile-stat-label">Statut</div>
        </div>
        <div class="profile-stat-divider"></div>
        <div class="profile-stat">
          <div class="profile-stat-value">{{ user.telephone ?? '—' }}</div>
          <div class="profile-stat-label">Téléphone</div>
        </div>
      </div>

      <a href="{{ path('profile_edit') }}" class="profile-edit-btn">
        ✏️ Modifier le profil
      </a>
    </div>

    <!-- Quick links -->
    <div class="profile-quick-links">
      <div class="quick-links-title">Accès rapide</div>
      <a href="{{ path('profile_edit') }}" class="quick-link-item">
        <span class="quick-link-icon">⚙️</span>
        <span>Paramètres du compte</span>
        <span class="quick-link-arrow">›</span>
      </a>
      <a href="{{ path('profile_2fa_index') }}" class="quick-link-item">
        <span class="quick-link-icon">🔐</span>
        <span>Authentification 2FA</span>
        <span class="quick-link-arrow">›</span>
      </a>
      {% if candidat and candidat.cvPath %}
      <a href="{{ candidat.cvPath starts with 'http' ? candidat.cvPath : asset(candidat.cvPath) }}" target="_blank" class="quick-link-item">
        <span class="quick-link-icon">📄</span>
        <span>Voir mon CV</span>
        <span class="quick-link-arrow">↗</span>
      </a>
      {% endif %}
    </div>
  </aside>

  <!-- Main content -->
  <main class="profile-main">

    <!-- Info cards row -->
    <div class="profile-info-grid">
      <div class="profile-info-card">
        <div class="info-card-icon">👤</div>
        <div class="info-card-body">
          <div class="info-card-label">Nom complet</div>
          <div class="info-card-value">{{ user.fullName }}</div>
        </div>
      </div>
      <div class="profile-info-card">
        <div class="info-card-icon">✉️</div>
        <div class="info-card-body">
          <div class="info-card-label">Email</div>
          <div class="info-card-value">{{ user.email }}</div>
        </div>
      </div>
      <div class="profile-info-card">
        <div class="info-card-icon">📱</div>
        <div class="info-card-body">
          <div class="info-card-label">Téléphone</div>
          <div class="info-card-value">{{ user.telephone ?? 'Non renseigné' }}</div>
        </div>
      </div>
      <div class="profile-info-card">
        <div class="info-card-icon">🟢</div>
        <div class="info-card-body">
          <div class="info-card-label">Statut du compte</div>
          <div class="info-card-value" style="color:#4ade80">{{ user.statut ?? 'Actif' }}</div>
        </div>
      </div>
    </div>

    {% if candidat %}
    <!-- Documents section -->
    <div class="profile-section-card">
      <div class="section-card-header">
        <div class="section-card-title">
          <span class="section-card-icon">📁</span>
          Documents
        </div>
        <a href="{{ path('profile_edit') }}" class="section-card-action">Mettre à jour</a>
      </div>

      <div class="docs-grid">
        <!-- CV -->
        <div class="doc-card {% if candidat.cvPath %}doc-card-filled{% else %}doc-card-empty{% endif %}">
          <div class="doc-card-icon">📄</div>
          <div class="doc-card-body">
            <div class="doc-card-title">Curriculum Vitae</div>
            {% if candidat.cvPath %}
              <div class="doc-card-meta">PDF · Uploadé</div>
              <a href="{{ candidat.cvPath starts with 'http' ? candidat.cvPath : asset(candidat.cvPath) }}"
                 target="_blank" class="doc-card-btn">Voir le CV ↗</a>
            {% else %}
              <div class="doc-card-meta" style="color:rgba(232,230,240,.3)">Aucun CV uploadé</div>
              <a href="{{ path('profile_edit') }}" class="doc-card-btn doc-card-btn-ghost">Ajouter →</a>
            {% endif %}
          </div>
        </div>

        <!-- Lettre de motivation -->
        <div class="doc-card {% if candidat.lettreMotivation %}doc-card-filled{% else %}doc-card-empty{% endif %}">
          <div class="doc-card-icon">✍️</div>
          <div class="doc-card-body">
            <div class="doc-card-title">Lettre de motivation</div>
            {% if candidat.lettreMotivation %}
              <div class="doc-card-meta">Rédigée · {{ candidat.lettreMotivation|length }} caractères</div>
              <button onclick="document.getElementById('lm-modal').style.display='flex'" class="doc-card-btn">Lire ↗</button>
            {% else %}
              <div class="doc-card-meta" style="color:rgba(232,230,240,.3)">Aucune lettre rédigée</div>
              <a href="{{ path('profile_edit') }}" class="doc-card-btn doc-card-btn-ghost">Rédiger →</a>
            {% endif %}
          </div>
        </div>
      </div>
    </div>

    {% if candidat.lettreMotivation %}
    <!-- Lettre modal -->
    <div id="lm-modal" style="display:none;position:fixed;inset:0;z-index:1000;background:rgba(0,0,0,.7);backdrop-filter:blur(6px);align-items:center;justify-content:center;padding:20px">
      <div style="background:#13122a;border:.5px solid rgba(108,99,255,.3);border-radius:20px;max-width:640px;width:100%;max-height:80vh;overflow-y:auto;padding:32px">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px">
          <div style="font-family:Sora,sans-serif;font-size:18px;font-weight:700;color:#fff">Lettre de motivation</div>
          <button onclick="document.getElementById('lm-modal').style.display='none'"
                  style="background:rgba(255,255,255,.08);border:.5px solid rgba(255,255,255,.1);border-radius:8px;color:rgba(232,230,240,.6);padding:6px 12px;cursor:pointer;font-size:13px">
            Fermer ✕
          </button>
        </div>
        <div style="font-size:14px;color:rgba(232,230,240,.75);line-height:1.8;white-space:pre-wrap">{{ candidat.lettreMotivation }}</div>
      </div>
    </div>
    {% endif %}
    {% endif %}

    <!-- Security section -->
    <div class="profile-section-card">
      <div class="section-card-header">
        <div class="section-card-title">
          <span class="section-card-icon">🔐</span>
          Sécurité
        </div>
      </div>
      <div class="security-items">
        <div class="security-item">
          <div class="security-item-left">
            <div class="security-item-title">Mot de passe</div>
            <div class="security-item-sub">Dernière modification inconnue</div>
          </div>
          <a href="{{ path('profile_edit') }}" class="security-item-btn">Modifier</a>
        </div>
        <div class="security-item">
          <div class="security-item-left">
            <div class="security-item-title">Authentification à deux facteurs</div>
            <div class="security-item-sub">
              {% if user.isTwoFactorEnabled %}
                <span style="color:#4ade80">✓ Activée</span>
              {% else %}
                <span style="color:rgba(232,230,240,.4)">Non configurée</span>
              {% endif %}
            </div>
          </div>
          <a href="{{ path('profile_2fa_index') }}" class="security-item-btn">Configurer</a>
        </div>
      </div>
    </div>

  </main>
</div>
</div>

<style>
.profile-layout{display:grid;grid-template-columns:280px 1fr;gap:24px;align-items:start}

/* Sidebar */
.profile-sidebar{display:flex;flex-direction:column;gap:16px;position:sticky;top:80px}
.profile-avatar-card{
  background:rgba(255,255,255,.03);border:.5px solid rgba(255,255,255,.08);
  border-radius:20px;padding:28px 24px;text-align:center;position:relative;overflow:hidden;
}
.profile-avatar-card::before{
  content:'';position:absolute;top:-60px;left:50%;transform:translateX(-50%);
  width:200px;height:200px;border-radius:50%;
  background:radial-gradient(circle,rgba(108,99,255,.15),transparent 70%);
  pointer-events:none;
}
.profile-avatar-img{
  width:88px;height:88px;border-radius:50%;object-fit:cover;
  border:2px solid rgba(108,99,255,.4);margin:0 auto 14px;display:block;
  box-shadow:0 0 0 4px rgba(108,99,255,.1);
}
.profile-avatar-initials{
  width:88px;height:88px;border-radius:50%;
  background:linear-gradient(135deg,#6C63FF,#9D6BFF);
  display:flex;align-items:center;justify-content:center;
  font-size:2rem;font-weight:700;color:#fff;
  margin:0 auto 14px;
  box-shadow:0 8px 24px rgba(108,99,255,.4),0 0 0 4px rgba(108,99,255,.1);
}
.profile-name{font-family:Sora,sans-serif;font-weight:700;font-size:16px;color:#fff;margin-bottom:4px}
.profile-email{font-size:12.5px;color:rgba(232,230,240,.4);margin-bottom:12px;word-break:break-all}
.profile-role-badge{
  display:inline-flex;align-items:center;gap:6px;
  padding:4px 12px;border-radius:100px;
  background:rgba(108,99,255,.12);border:.5px solid rgba(108,99,255,.25);
  font-size:11.5px;font-weight:600;color:#a89bff;margin-bottom:18px;
}
.role-dot{width:6px;height:6px;border-radius:50%;display:inline-block}
.role-admin{background:#f59e0b}
.role-worker{background:#3b82f6}
.role-candidat{background:#6C63FF}

.profile-stats{display:flex;align-items:center;gap:0;margin-bottom:20px;background:rgba(255,255,255,.04);border:.5px solid rgba(255,255,255,.07);border-radius:12px;overflow:hidden}
.profile-stat{flex:1;padding:12px 8px;text-align:center}
.profile-stat-divider{width:.5px;background:rgba(255,255,255,.07);align-self:stretch}
.profile-stat-value{font-family:Sora,sans-serif;font-size:13px;font-weight:700;color:#e8e6f0;margin-bottom:2px}
.profile-stat-label{font-size:10.5px;color:rgba(232,230,240,.35);text-transform:uppercase;letter-spacing:.04em}

.profile-edit-btn{
  display:block;width:100%;padding:11px;
  background:linear-gradient(135deg,#6C63FF,#9D6BFF);
  border:none;border-radius:11px;
  color:#fff;font-size:13.5px;font-weight:600;
  text-decoration:none;text-align:center;
  transition:opacity .2s,transform .15s;
  box-shadow:0 4px 16px rgba(108,99,255,.35);
}
.profile-edit-btn:hover{opacity:.9;transform:translateY(-1px)}

/* Quick links */
.profile-quick-links{
  background:rgba(255,255,255,.03);border:.5px solid rgba(255,255,255,.08);
  border-radius:16px;padding:16px;
}
.quick-links-title{font-size:11px;font-weight:600;color:rgba(232,230,240,.35);text-transform:uppercase;letter-spacing:.06em;margin-bottom:10px;padding:0 4px}
.quick-link-item{
  display:flex;align-items:center;gap:10px;
  padding:10px 10px;border-radius:10px;
  color:rgba(232,230,240,.65);font-size:13px;text-decoration:none;
  transition:background .15s,color .15s;
}
.quick-link-item:hover{background:rgba(108,99,255,.12);color:#e8e6f0}
.quick-link-icon{font-size:15px;width:20px;text-align:center}
.quick-link-arrow{margin-left:auto;color:rgba(232,230,240,.3);font-size:16px}

/* Main */
.profile-main{display:flex;flex-direction:column;gap:20px}

/* Info grid */
.profile-info-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.profile-info-card{
  display:flex;align-items:center;gap:14px;
  background:rgba(255,255,255,.03);border:.5px solid rgba(255,255,255,.08);
  border-radius:14px;padding:16px 18px;
  transition:border-color .2s;
}
.profile-info-card:hover{border-color:rgba(108,99,255,.25)}
.info-card-icon{font-size:20px;width:36px;height:36px;border-radius:10px;background:rgba(108,99,255,.12);display:flex;align-items:center;justify-content:center;flex-shrink:0}
.info-card-label{font-size:11px;color:rgba(232,230,240,.35);text-transform:uppercase;letter-spacing:.05em;margin-bottom:3px}
.info-card-value{font-size:14px;font-weight:600;color:#e8e6f0}

/* Section cards */
.profile-section-card{
  background:rgba(255,255,255,.03);border:.5px solid rgba(255,255,255,.08);
  border-radius:18px;padding:22px 24px;
}
.section-card-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:18px}
.section-card-title{display:flex;align-items:center;gap:10px;font-family:Sora,sans-serif;font-size:15px;font-weight:700;color:#fff}
.section-card-icon{font-size:18px}
.section-card-action{font-size:12.5px;color:#9D6BFF;text-decoration:none;font-weight:500}
.section-card-action:hover{text-decoration:underline}

/* Docs */
.docs-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.doc-card{
  display:flex;align-items:flex-start;gap:14px;
  padding:16px;border-radius:14px;
  border:.5px solid rgba(255,255,255,.07);
  background:rgba(255,255,255,.02);
  transition:border-color .2s;
}
.doc-card-filled{border-color:rgba(108,99,255,.2);background:rgba(108,99,255,.05)}
.doc-card:hover{border-color:rgba(108,99,255,.3)}
.doc-card-icon{font-size:22px;width:40px;height:40px;border-radius:10px;background:rgba(108,99,255,.12);display:flex;align-items:center;justify-content:center;flex-shrink:0}
.doc-card-title{font-size:13.5px;font-weight:600;color:#e8e6f0;margin-bottom:4px}
.doc-card-meta{font-size:12px;color:rgba(232,230,240,.45);margin-bottom:10px}
.doc-card-btn{
  display:inline-block;padding:5px 12px;border-radius:8px;
  background:linear-gradient(135deg,#6C63FF,#9D6BFF);
  color:#fff;font-size:12px;font-weight:600;text-decoration:none;
  border:none;cursor:pointer;
}
.doc-card-btn-ghost{
  background:rgba(255,255,255,.06);border:.5px solid rgba(255,255,255,.1);color:rgba(232,230,240,.6);
}

/* Security */
.security-items{display:flex;flex-direction:column;gap:0}
.security-item{
  display:flex;align-items:center;justify-content:space-between;
  padding:14px 0;border-bottom:.5px solid rgba(255,255,255,.06);
}
.security-item:last-child{border-bottom:none;padding-bottom:0}
.security-item-title{font-size:14px;font-weight:600;color:#e8e6f0;margin-bottom:3px}
.security-item-sub{font-size:12.5px;color:rgba(232,230,240,.4)}
.security-item-btn{
  padding:7px 16px;border-radius:9px;
  background:rgba(255,255,255,.06);border:.5px solid rgba(255,255,255,.1);
  color:rgba(232,230,240,.7);font-size:12.5px;font-weight:500;text-decoration:none;
  transition:background .15s,color .15s;flex-shrink:0;
}
.security-item-btn:hover{background:rgba(108,99,255,.15);color:#e8e6f0;border-color:rgba(108,99,255,.3)}

@media(max-width:900px){
  .profile-layout{grid-template-columns:1fr}
  .profile-sidebar{position:static}
  .profile-info-grid{grid-template-columns:1fr}
  .docs-grid{grid-template-columns:1fr}
}
</style>
{% endblock %}
